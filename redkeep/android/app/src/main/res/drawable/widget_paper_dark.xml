<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget night paper: ink-dark with a faint candle glow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="300"
                android:startColor="#251E29"
                android:centerColor="#18131C"
                android:endColor="#0E0B11"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:centerX="0.15"
                android:centerY="0.0"
                android:startColor="#22E0A060"
                android:endColor="#00E0A060" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#2EE9D8B4" />
        </shape>
    </item>
</layer-list>
