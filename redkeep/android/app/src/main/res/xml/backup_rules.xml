<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude domain="file" path="voice_sessions/" />
    <exclude domain="file" path="diary_photo_uploads/" />
    <!-- Drive backup progress and staging: device-specific, never restored. -->
    <exclude domain="file" path="sync_wise/" />
    <!-- The journal is restored from its Drive backup, never by Android: an
         older device-backup copy would hide the newer Drive backup. -->
    <exclude domain="file" path="redkeep.sqlite" />
    <exclude domain="file" path="redkeep.sqlite-journal" />
    <exclude domain="file" path="redkeep.sqlite-wal" />
    <exclude domain="file" path="redkeep.sqlite-shm" />
    <exclude domain="sharedpref" path="redkeep_companion.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:redkeep_companion.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage:redkeep_companion.xml" />
</full-backup-content>
