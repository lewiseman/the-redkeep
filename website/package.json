{
  "name": "redkeep-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "build": "npm run typecheck && vite build && node scripts/prerender.mjs && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "gsap": "^3.15.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "5.9.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "8.72.1",
    "globals": "^17.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0"
  }
}
